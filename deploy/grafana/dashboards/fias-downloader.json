{
  "title": "FIAS Downloader",
  "uid": "fias-downloader",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["fias-downloader"],
  "panels": [
    {
      "id": 1,
      "title": "Загрузки в процессе",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(fias_download_in_progress)",
          "legendFormat": "in progress",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Последняя успешная full-версия",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "fias_last_completed_version_id{kind=\"full\"}",
          "legendFormat": "full",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Последняя успешная delta-версия",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "fias_last_completed_version_id{kind=\"delta\"}",
          "legendFormat": "delta",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Последний цикл был",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "time() - fias_last_cycle_timestamp_seconds",
          "legendFormat": "seconds ago",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Загрузки по результату (за 5 минут)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind, result) (rate(fias_download_total[5m]))",
          "legendFormat": "{{kind}} / {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Циклы проверки/загрузки по результату (за 5 минут)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(fias_cycle_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Скорость загрузки (байт/с, по типу файла)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (kind) (rate(fias_download_bytes_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "Длительность загрузки файла, p50/p95 (по типу)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, kind) (rate(fias_download_duration_seconds_bucket[15m])))",
          "legendFormat": "p50 {{kind}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(fias_download_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "Длительность цикла проверки/загрузки, p50/p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fias_cycle_duration_seconds_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fias_cycle_duration_seconds_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Запросы перечня версий к источнику (за 5 минут)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(fias_source_fetch_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 11,
      "title": "Текущая загрузка: размер файла",
      "type": "stat",
      "description": "Ожидаемый размер файла активной загрузки (по Content-Length). Пусто, если сейчас ничего не загружается.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "fias_download_progress_total_bytes",
          "legendFormat": "{{kind}} v{{version_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] }
    },
    {
      "id": 12,
      "title": "Текущая загрузка: уже загружено",
      "type": "stat",
      "description": "Сколько байт уже загружено для активной загрузки. Пусто, если сейчас ничего не загружается.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "fias_download_progress_downloaded_bytes",
          "legendFormat": "{{kind}} v{{version_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Текущая загрузка: прогресс, %",
      "type": "gauge",
      "description": "Доля уже загруженных байт от ожидаемого размера файла активной загрузки.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(fias_download_progress_downloaded_bytes / fias_download_progress_total_bytes) * 100",
          "legendFormat": "{{kind}} v{{version_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Активных загрузок сейчас",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(fias_download_progress_total_bytes)",
          "legendFormat": "активных загрузок",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 15,
      "title": "Прогресс загрузки во времени (загружено vs всего)",
      "type": "timeseries",
      "description": "Линии обрываются, когда загрузка завершается (успешно или с ошибкой) — метрика существует только для активных загрузок.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "fias_download_progress_downloaded_bytes",
          "legendFormat": "загружено: {{kind}} v{{version_id}}",
          "refId": "A"
        },
        {
          "expr": "fias_download_progress_total_bytes",
          "legendFormat": "всего: {{kind}} v{{version_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] }
    }
  ]
}
